# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration (Aiven MySQL)
DB_DRIVER=mysql
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4
DB_PREFIX=
# Path to the Aiven CA certificate file (needed because Aiven requires TLS).
# Local example: C:/certs/aiven-ca.pem   Render example: /etc/secrets/ca.pem
DB_SSL_CA=
# Alternative to DB_SSL_CA: the certificate as one base64 line (useful on Render).
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\path\to\ca.pem"))
DB_SSL_CA_BASE64=

# For API (each at least 32 random characters, and they must differ)
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Allowed browser origin(s) for CORS, comma-separated. Leave empty locally.
# Example: https://your-app.vercel.app
ALLOW_ORIGIN=

# Set to true ONLY in your local .env when running migrations. Never on Render.
MIGRATION_ENABLED=false
